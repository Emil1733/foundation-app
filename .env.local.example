# Copy to .env.local and fill values from the authorized project dashboard.
# Never commit real credentials, even in an example file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Never use a NEXT_PUBLIC_ prefix for this credential.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SECRET
ADMIN_SECRET=YOUR_RANDOM_ADMIN_SECRET
